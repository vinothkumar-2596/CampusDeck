{
  "name": "campusdeck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server/local.ts",
    "dev:mongo": "node --env-file=.env.local --import tsx server/local.ts",
    "build": "tsc -b && vite build && tsx scripts/build-worker.ts",
    "start": "tsx server/local.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:mongo": "node --env-file=.env.local --import tsx scripts/test-mongo.ts",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.7.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "jszip": "^3.10.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
