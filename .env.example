# Standalone server configuration. Node 24 or newer required.
PORT=5173
HOST=127.0.0.1
# Set to your canonical HTTPS origin when running behind a reverse proxy.
# PUBLIC_ORIGIN=https://campusdeck.example.com
# SQLite persists here; mount this path as a volume in production.
DATABASE_PATH=.data/campusdeck.sqlite
# Comma separated email allowlist. Only an existing registered account is promoted.
ADMIN_EMAILS=
# Set for HTTPS behind a trusted reverse proxy.
SECURE_COOKIES=false
# Hosted Sites automatically provides authenticated identity; standalone uses passwords.
# Payments are intentionally unavailable until a verified provider adapter is configured.
# Vercel uses MongoDB Atlas. The Marketplace integration provisions MONGODB_URI.
# Keep the real URI server-side in Vercel or the gitignored .env.local file.
# MONGODB_URI=
MONGODB_DATABASE=campusdeck
